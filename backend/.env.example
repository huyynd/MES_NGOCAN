# Copy this file to backend/.env for local development. Never commit backend/.env.
# For Render, configure the same values in the service Environment dashboard.

PORT=4000
CORS_ORIGINS=http://localhost:5173

# Supabase PostgreSQL connection string. Prefer the Transaction pooler URL in production.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres

# Generate a long random value for each environment.
JWT_SECRET=replace-with-a-long-random-secret
